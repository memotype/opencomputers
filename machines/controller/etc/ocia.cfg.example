# Rendered by deploy.lua for the controller; keep local identities in deploy.local.lua.
controller_address=CONTROLLER_MODEM_UUID
robot_address=ROBOT_MODEM_UUID
port=4242
protocol_version=1
timeout=8
recent_results=32
compact_records=128
compact_bytes=65536
legacy_enabled=true
